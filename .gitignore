.DS_Store
.Rhistory
node_modules/
dist/
build/
*.log

# Generated web and iOS build artifacts. Hand-authored Xcode sources,
# entitlements, extension plists, project/workspace metadata and lockfiles stay
# tracked so a release commit fully identifies the native archive.
www/
ios/App/Pods/
ios/App/App/public/
ios/App/App/config.xml
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/App/.DS_Store
ios/capacitor-cordova-ios-plugins/

# Xcode IPA exports land in native-ios/<scheme> <date>/ and are ~50MB each
native-ios/*/*.ipa
native-ios/DeviceActivityMonitor */
native-ios/App */

# never commit an API key, just in case one lands in the repo
.openai-mrtapioca
*.key
.claude/
tools/__pycache__/
__pycache__/
.venv/

# scratch output from tools/gen-poses.py (cells are reviewed, then copied into assets/poses/)
build/

# The focus-tunes audition reel is a listening aid for picking the playlist, not
# a shipped asset. The tracks themselves ARE committed (assets/music/); this is
# just 5 MB of the same audio with title cards on it.
marketing/focus-tunes-audition.mp4

# ── Internal build notes. NEVER commit these: the repo is PUBLIC. ─────────────
# docs/network-v1/GROUNDING.md is a step-by-step guide to forging rewards in the
# LIVE app (the exact localStorage keys, and the payload that produced 416 free
# rewards at a real partner shop). Publishing it hands that to anyone, and the
# shop pays for it. The rest of the folder describes the same holes.
#
# The files stay on this Mac. They are just never pushed. Back them up outside
# the repo if you want them somewhere safe.
docs/network-v1/
docs/qa-screenshots-network-v1/

# Isolated agent worktrees are local scratch and must never enter the public repo.
.worktrees/
